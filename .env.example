# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# cp .env.example .env

# API 서버 주소 (필수)
USER_DASHBOARD_API_URL=https://newshopping-shorts-auth.vercel.app

# Password reset queue-to-auth HMAC. Set the same random 32+ character value
# on this Vercel project and the newshopping-shorts-auth Vercel project.
PASSWORD_RESET_PROXY_SECRET=

# Server-only shared password-reset limiter. Use the Upstash standard write
# token and a separate random 32+ character HMAC secret. Never expose these
# values to browser code.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PASSWORD_RESET_RATE_LIMIT_HMAC_SECRET=
# Vercel Marketplace may inject KV_REST_API_URL and KV_REST_API_TOKEN instead.
# They are supported aliases; prefer the UPSTASH_REDIS_REST_* names when both exist.

# Optional fixed-window tuning. Defaults are shown.
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=600
PASSWORD_RESET_RATE_LIMIT_IP_MAX=10
PASSWORD_RESET_RATE_LIMIT_IDENTIFIER_MAX=3

# Optional CAPTCHA hook. Configure only after the request page sends captcha_token.
# TURNSTILE_SECRET_KEY=

# PayApp API checkout
# Server-owned plans:
#   stmaker_pro_week (7 days / 19,000 KRW / Coupang)
#   stmaker_shopping_pro_week (7 days / 29,000 KRW / multi-market)
#   stmaker_pro_month (monthly / 49,000 KRW / Coupang)
#   stmaker_shopping_pro_month (monthly / 69,000 KRW / multi-market)
# The 59,000 KRW founder transition plan is hidden and server-eligibility only.
# IMPORTANT (backend):
#   Cloud Run/ECS payment API must provide PAYAPP_USERID, PAYAPP_LINKKEY, PAYAPP_LINKVAL
#   and PAYMENT_API_BASE_URL in production.
THREAD_AUTO_PAYAPP_PAYMENT_TYPE=vbank
THREAD_AUTO_FREE_TRIAL_WORK_COUNT=5

# Optional fallback: direct PayApp URL when API checkout fails
THREAD_AUTO_PAYAPP_URL=

# Kakao support chat URL override (optional)
THREAD_AUTO_KAKAO_CONTACT_URL=https://open.kakao.com/o/sVkZPsfi
