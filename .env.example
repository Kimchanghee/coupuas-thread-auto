# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# cp .env.example .env

# API 서버 주소 (필수)
USER_DASHBOARD_API_URL=https://newshopping-shorts-auth.vercel.app

# PayApp API checkout
# Server-owned plans:
#   stmaker_pro_week (7 days / 19,000 KRW / Coupang)
#   stmaker_shopping_pro_week (7 days / 29,000 KRW / multi-market)
#   stmaker_pro_month (monthly / 49,000 KRW / Coupang)
#   stmaker_shopping_pro_month (monthly / 69,000 KRW / multi-market)
# The 59,000 KRW founder transition plan is hidden and server-eligibility only.
# IMPORTANT (backend):
#   Cloud Run/ECS payment API must provide PAYAPP_USERID, PAYAPP_LINKKEY, PAYAPP_LINKVAL
#   and PAYMENT_API_BASE_URL in production.
THREAD_AUTO_PAYAPP_PAYMENT_TYPE=vbank
THREAD_AUTO_FREE_TRIAL_WORK_COUNT=5

# Optional fallback: direct PayApp URL when API checkout fails
THREAD_AUTO_PAYAPP_URL=

# Kakao support chat URL override (optional)
THREAD_AUTO_KAKAO_CONTACT_URL=https://open.kakao.com/o/sVkZPsfi
