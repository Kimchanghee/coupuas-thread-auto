# Authoritative Upstash Redis REST store. Prefer this official Upstash pair.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Vercel Marketplace (upstash/upstash-kv) may inject these aliases instead.
# Leave the UPSTASH_* pair unset when using the KV_* pair.
# KV_REST_API_URL=https://example.upstash.io
# KV_REST_API_TOKEN=replace-with-vercel-kv-rest-token

# At least 32 unpredictable characters. Used only for HMAC identifiers/proofs.
SURVEY_SECURITY_HMAC_SECRET=
# Separate 32+ character secret required in x-survey-health-check-secret.
SURVEY_HEALTH_CHECK_SECRET=
SURVEY_RATE_LIMIT_IP_PER_HOUR=10
SURVEY_RATE_LIMIT_EMAIL_PER_DAY=3

# Google Sheets best-effort reporting mirror.
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-spreadsheet-id
GOOGLE_SHEETS_SHEET_NAME=응답 원본
GCP_PROJECT_NUMBER=replace-with-project-number
GCP_SERVICE_ACCOUNT_EMAIL=replace-with-service-account@project.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=replace-with-workload-identity-pool
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=replace-with-provider
